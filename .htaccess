RewriteEngine On

RewriteRule ^HTML/index\.html$ index.php [R=301,L,NC]
RewriteRule ^HTML/AboutImus\.html$ Pages/AboutImus.php [R=301,L,NC]
RewriteRule ^HTML/Services\.html$ Pages/Services.php [R=301,L,NC]
RewriteRule ^HTML/Tourism\.html$ Pages/Tourism.php [R=301,L,NC]
RewriteRule ^HTML/Business\.html$ Pages/Business.php [R=301,L,NC]
RewriteRule ^HTML/Contact-Us\.html$ Pages/Contact-Us.php [R=301,L,NC]
RewriteRule ^HTML/Downloadable-forms\.html$ Pages/Downloadable-Forms.php [R=301,L,NC]
RewriteRule ^HTML/Full-disclosure\.html$ Pages/Full-Disclosure.php [R=301,L,NC]
RewriteRule ^HTML/Employees-Hub\.html$ index.php [R=301,L,NC]
RewriteRule ^HTML/test\.html$ index.php [R=301,L,NC]

<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
